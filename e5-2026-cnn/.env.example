# Base de données MySQL (Obligatoire)
MYSQL_ROOT_PASSWORD=votre_mot_de_passe_root     # exemple : root_secret
MYSQL_DATABASE=nom_de_la_base_de_donnees        # exemple : db_cnn
MYSQL_USER=nom_utilisateur                      # exemple : my_user
MYSQL_PASSWORD=votre_mot_de_passe               # exemple : my_password

# Ports exposés sur la machine hôte (Optionnels)
DB_PORT=3306
ADMINER_PORT=8080
API_PORT=8081
CLIENT_PORT=8501